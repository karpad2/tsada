{
  "name": "tsada",
  "version": "1.1.8beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "node server.js",
    "build": "vite build",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.js",
    "build:ssr": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "preview:ssr": "NODE_ENV=production node server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "vite --config vite-dc.config.js",
    "build:dc": "vite build --config vite-dc.config.js && node scripts/build-electron.mjs",
    "electron:build": "npm run build:dc && (electron-builder --dir || true) && node scripts/package-dc.mjs",
    "python:dev": "npm run build:dc && python dc-python/main.py",
    "python:build": "npm run build:dc && cd dc-python && pyinstaller dc-chat.spec --clean --noconfirm",
    "csharp:build": "dotnet build dc-csharp -c Release",
    "csharp:publish": "dotnet publish dc-csharp -c Release -r win-x64 --self-contained -o release/dc-csharp",
    "csharp:run": "dotnet run --project dc-csharp"
  },
  "dependencies": {
    "@fireworks-js/vue": "^2.10.8",
    "@ipaat/vue3-tailwind3-cookie-comply": "^1.1.2",
    "@kyvg/vue3-notification": "^3.4.1",
    "@mayasabha/ckeditor4-vue3": "^1.0.9",
    "@primevue/themes": "^4.2.1",
    "@tsparticles/vue3": "^3.0.1",
    "@vueup/vue-quill": "^1.2.0",
    "appwrite": "^21.5.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.19",
    "dexie": "^4.3.0",
    "express": "^4.21.1",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.6",
    "peerjs": "^1.5.5",
    "pinia": "^2.2.6",
    "pinia-plugin-persistedstate": "^4.1.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.1",
    "swiper": "^11.1.14",
    "three": "^0.170.0",
    "tsparticles": "^3.5.0",
    "v-viewer": "^3.0.21",
    "vee-validate": "^4.14.7",
    "viewerjs": "^1.11.6",
    "vue": "^3.5.12",
    "vue-country-flag-next": "^2.3.2",
    "vue-gtag": "^3.6.1",
    "vue-i18n": "^10.0.4",
    "vue-responsive-video-background-player": "^2.3.1",
    "vue-router": "^4.4.5",
    "vue3-lazyload": "^0.3.8",
    "vuedraggable": "^4.1.0",
    "vuestic-ui": "^1.10.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "happy-dom": "^18.0.1",
    "jsdom": "^27.0.0",
    "leaflet": "^1.9.4",
    "node-appwrite": "^21.1.0",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^6.0.1",
    "sirv": "^2.0.4",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-pwa": "^0.21.0",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^3.2.4",
    "vue-cli-plugin-i18n": "~2.3.2",
    "vuetify": "^3.7.4",
    "wait-on": "^8.0.5"
  },
  "description": "This template should help get you started developing with Vue 3 in Vite.",
  "main": "dist-electron/main.mjs",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "rs.edu.tsada.dc",
    "productName": "DC Chat",
    "copyright": "Tehnička Škola Ada",
    "asar": false,
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-dc/**/*",
      "dist-electron/**/*",
      "public/favicon.png"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.png"
    }
  }
}
